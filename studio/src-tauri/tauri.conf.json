{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JTAGulator Studio",
  "version": "0.1.3",
  "identifier": "com.jtagulator.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JTAGulator Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; script-src 'self' blob:; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Desktop frontend for the JTAGulator",
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "jtagulator-studio",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3NkFFOTJBRUI2NkYyNUIKUldSYjhtYnJLdWxxTjlsM0ltT1dXNFluaG9ESzFyTkNOSnJLSHFJSXI3Vk5Cakx3VCtycTFNR2UK",
      "endpoints": [
        "https://github.com/gilbertorconde/jtagulator-ID-Tracker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
